msgid "plugins.reports.responseExporter.displayName"
msgstr "Review Response Exporter Plugin"

msgid "plugins.reports.responseExporter.description"
msgstr "The Response Exporter plugin generates a CSV report with the review responses associated with submissions. It offers two export options: one for numeric responses only and another for all responses."

msgid "plugins.reports.responseExporter.submission.Id"
msgstr "Submission ID"

msgid "plugins.reports.responseExporter.submission.title"
msgstr "Submission Title"

msgid "plugins.reports.responseExporter.reviewer"
msgstr "Reviewer"

msgid "plugins.reports.responseExporter.reviewer.id"
msgstr "Reviewer ID"

msgid "plugins.reports.responseExporter.reviewer.email"
msgstr "Reviewer Email"

msgid "plugins.reports.responseExporter.reviewer.familyName"
msgstr "Reviewer Last Name"

msgid "plugins.reports.responseExporter.reviewer.givenName"
msgstr "Reviewer First Name"

msgid "plugins.reports.responseExporter.author.email"
msgstr "Author Email"

msgid "plugins.reports.responseExporter.settings.title"
msgstr "Response Exporter Plugin Settings"

msgid "plugins.reports.responseExporter.settings.numericalAnswersEnabled"
msgstr "Enable/Disable Numerical Responses"

msgid "plugins.reports.responseExporter.settings.description"
msgstr "This plugin allows you to extract the review scores associated with each submission. When enabled, you will have access to a report with the scores given by reviewers, facilitating the analysis and management of the review process results."

msgid "plugins.reports.responseExporter.settings.validation"
msgstr "Choose whether to include only numerical responses"

msgid "plugins.reports.responseExporter.settings.required"
msgstr "This field is required."

msgid "plugins.reports.responseExporter.settings.form.radio.labelYes"
msgstr "Yes"

msgid "plugins.reports.responseExporter.settings.form.radio.labelNo"
msgstr "No"

msgid "plugins.reports.responseExporter.settings.form.numericalLabel"
msgstr "Do you want to extract only numerical responses?"

msgid "plugins.reports.responseExporter.response.value"
msgstr "Response"

msgid "plugins.reports.responseExporter.response.type"
msgstr "Response Type"
